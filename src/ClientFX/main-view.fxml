<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="ClientFX.MainController"
      spacing="15"
      style="-fx-padding: 20; -fx-background-color: #f4f4f4;">

    <Label text="Système de Vidéosurveillance"
           style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <HBox spacing="10">
        <Button fx:id="btnRefresh"  text="Rafraichir"    onAction="#onRefresh"/>
        <Button fx:id="btnStartAll" text="Start Toutes"  onAction="#onStartAll"/>
        <Button fx:id="btnStopAll"  text="Stop Toutes"   onAction="#onStopAll"/>
    </HBox>

    <Label fx:id="lblStatus" text=""/>

    <TableView fx:id="tableView" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId"         text="ID"                  prefWidth="60"/>
            <TableColumn fx:id="colStatus"     text="Statut"              prefWidth="150"/>
            <TableColumn fx:id="colLastUpdate" text="Derniere mise a jour" prefWidth="220"/>
            <TableColumn fx:id="colAction"     text="Action"              prefWidth="160"/>
        </columns>
    </TableView>

</VBox>